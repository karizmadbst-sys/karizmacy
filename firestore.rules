rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPER PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
             'email_verified' in request.auth.token &&
             'email' in request.auth.token &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'aistudio.gamer.2@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
             (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidCatalogItem(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             (!('titleAr' in data) || (data.titleAr is string && data.titleAr.size() <= 100)) &&
             data.itemType is string && data.itemType in ['GAME', 'APP'] &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.developer is string && data.developer.size() >= 1 && data.developer.size() <= 80 &&
             data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 240 &&
             (!('summaryAr' in data) || (data.summaryAr is string && data.summaryAr.size() <= 240)) &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 3000 &&
             (!('descriptionAr' in data) || (data.descriptionAr is string && data.descriptionAr.size() <= 3000)) &&
             data.version is string && data.version.size() >= 1 && data.version.size() <= 32 &&
             data.fileSize is string && data.fileSize.size() >= 1 && data.fileSize.size() <= 32 &&
             data.downloadUrl is string && data.downloadUrl.size() >= 8 && data.downloadUrl.size() <= 500 &&
             data.downloadUrl.matches('^https?://.+') &&
             data.coverImageUrl is string && data.coverImageUrl.size() <= 250000 &&
             data.screenshotUrls is list && data.screenshotUrls.size() <= 5 &&
             (data.screenshotUrls.size() == 0 || (data.screenshotUrls[0] is string && data.screenshotUrls[0].size() <= 200000)) &&
             data.rating is number && data.rating >= 0 && data.rating <= 5 &&
             data.downloadsCount is int && data.downloadsCount >= 0 &&
             data.featured is bool &&
             data.published is bool &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAdminRecord(data) {
      return data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             data.role is string && data.role == 'admin' &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.preferredLanguage is string && data.preferredLanguage in ['en', 'ar'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidFavoriteEntry(data) {
      return data.itemId is string && isValidId(data.itemId) &&
             data.itemTitle is string && data.itemTitle.size() >= 1 && data.itemTitle.size() <= 100 &&
             data.itemType is string && data.itemType in ['GAME', 'APP'] &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidDownloadLog(data) {
      return data.itemId is string && isValidId(data.itemId) &&
             data.itemTitle is string && data.itemTitle.size() >= 1 && data.itemTitle.size() <= 100 &&
             data.itemType is string && data.itemType in ['GAME', 'APP'] &&
             data.version is string && data.version.size() >= 1 && data.version.size() <= 32 &&
             data.downloadUrl is string && data.downloadUrl.size() >= 8 && data.downloadUrl.size() <= 500 &&
             data.downloadUrl.matches('^https?://.+') &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // --- 1. STORE CATALOG COLLECTION ---
    match /catalog_items/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId) &&
                    (existing().published == true || isAdmin());

      // Evaluates resource.data directly without get()/exists() lookups.
      allow list: if isSignedIn() &&
                     (resource.data.published == true || resource.data.createdBy == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(itemId) &&
                       incoming().keys().hasAll([
                         'title', 'itemType', 'category', 'developer', 'summary',
                         'description', 'version', 'fileSize', 'downloadUrl',
                         'coverImageUrl', 'screenshotUrls', 'rating', 'downloadsCount',
                         'featured', 'published', 'createdBy', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'title', 'titleAr', 'itemType', 'category', 'developer', 'summary',
                         'summaryAr', 'description', 'descriptionAr', 'version', 'fileSize',
                         'downloadUrl', 'coverImageUrl', 'screenshotUrls', 'rating',
                         'downloadsCount', 'featured', 'published', 'createdBy',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdBy == request.auth.uid &&
                       isValidCatalogItem(incoming()) &&
                       isAdmin();

      allow update: if isSignedIn() &&
                       isValidId(itemId) &&
                       isValidCatalogItem(incoming()) &&
                       incoming().keys().hasOnly([
                         'title', 'titleAr', 'itemType', 'category', 'developer', 'summary',
                         'summaryAr', 'description', 'descriptionAr', 'version', 'fileSize',
                         'downloadUrl', 'coverImageUrl', 'screenshotUrls', 'rating',
                         'downloadsCount', 'featured', 'published', 'createdBy',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Admin full edit
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'title', 'titleAr', 'itemType', 'category', 'developer', 'summary',
                            'summaryAr', 'description', 'descriptionAr', 'version', 'fileSize',
                            'downloadUrl', 'coverImageUrl', 'screenshotUrls', 'rating',
                            'downloadsCount', 'featured', 'published', 'updatedAt'
                          ])) ||
                         // Action 2: Authenticated user download counter increment
                         (existing().published == true &&
                          incoming().downloadsCount == existing().downloadsCount + 1 &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['downloadsCount', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(itemId) && isAdmin();
    }

    // --- 2. ADMINS REGISTRY COLLECTION ---
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) &&
                    (request.auth.uid == adminUid || isBootstrappedAdmin());

      allow list: if isBootstrappedAdmin() && resource.data.role == 'admin';

      allow create: if isBootstrappedAdmin() &&
                       isValidId(adminUid) &&
                       incoming().keys().hasAll(['email', 'role', 'createdAt']) &&
                       incoming().keys().hasOnly(['email', 'role', 'createdAt']) &&
                       isValidAdminRecord(incoming());

      allow update: if isBootstrappedAdmin() &&
                       isValidId(adminUid) &&
                       isValidAdminRecord(incoming()) &&
                       incoming().keys().hasOnly(['email', 'role', 'createdAt']) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role']);

      allow delete: if isBootstrappedAdmin() && isValidId(adminUid);
    }

    // --- 3. OWNER-ISOLATED USER PROFILES & SUBCOLLECTIONS ---
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'preferredLanguage', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'preferredLanguage', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'preferredLanguage', 'createdAt', 'updatedAt']) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'preferredLanguage', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /favorites/{itemId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(itemId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(itemId) &&
                         request.auth.uid == userId &&
                         incoming().itemId == itemId &&
                         incoming().keys().hasAll(['itemId', 'itemTitle', 'itemType', 'createdAt']) &&
                         incoming().keys().hasOnly(['itemId', 'itemTitle', 'itemType', 'createdAt']) &&
                         isValidFavoriteEntry(incoming()) &&
                         exists(/databases/$(database)/documents/catalog_items/$(itemId));

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(itemId) && request.auth.uid == userId;
      }

      match /downloads/{downloadId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(downloadId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(downloadId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll(['itemId', 'itemTitle', 'itemType', 'version', 'downloadUrl', 'createdAt']) &&
                         incoming().keys().hasOnly(['itemId', 'itemTitle', 'itemType', 'version', 'downloadUrl', 'createdAt']) &&
                         isValidDownloadLog(incoming()) &&
                         exists(/databases/$(database)/documents/catalog_items/$(incoming().itemId));

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(downloadId) && request.auth.uid == userId;
      }
    }
  }
}
